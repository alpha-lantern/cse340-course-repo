<%- include('partials/header') %>
<main class="container org-detail">
    <!-- General Page Title -->
    <h1 class="page-title"><%= title %></h1>
    <!-- Organization Header Profile Card -->
    <header class="org-header-card">
        <img class="org-detail-logo" src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
        <div class="org-header-info">
            <!-- Organization Name updated to H2 -->
            <h2 class="org-title"><%= organizationDetails.name %></h2>
            <a class="org-email-link" href="mailto:<%= organizationDetails.contact_email %>">
                ✉️ <%= organizationDetails.contact_email %>
            </a>
        </div>
    </header>
    <!-- Projects List Section -->
    <section class="org-projects-section">
        <h3 class="org-projects-title">Projects by <%= organizationDetails.name %></h3>
        <% if (projects && projects.length > 0) { %>
            <ul class="project-list">
                <% projects.forEach(project => { %>
                    <li class="project-card">
                        <div class="project-content">
                            <h4 class="project-title">
                                <a href="/project/<%= project.project_id %>" class="project-link">
                                    <%= project.title %>
                                </a>
                            </h4>
                        </div>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p class="no-projects-msg">No active projects found for this organization.</p>
        <% } %>
    </section>
    <div class="org-actions">
        <a href="/organizations" class="btn-primary">← Back to Organizations</a>
    </div>
</main>
<%- include('partials/footer') %>