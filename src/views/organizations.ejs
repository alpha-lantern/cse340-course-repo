<%- include('partials/header') %>
<main class="container">
    <h1 class="page-title"><%= title %></h1>
    <p class="section-description">Here are a few of our partner organizations:</p>
    <ul class="org-grid">
        <% organizations.forEach(org => { %> 
            <li class="org-card">
                <img class="org-logo" src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">
                <div class="org-info">
                    <strong class="org-name"><%= org.name %></strong>
                    <a class="org-email" href="mailto:<%= org.contact_email %>"><%= org.contact_email %></a>
                </div>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>