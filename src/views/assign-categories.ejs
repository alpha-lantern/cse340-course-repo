<%- include('partials/header') %>
<main class="container">
  <h1 class="page-title"><%= projectDetails.title %></h1>
  <h2 class="hero-heading">Assign Categories</h2>

  <form action="/project/<%= projectId %>/assign-categories" method="POST" class="form-container">
    <div class="form-group">
      <label class="form-label">Select Categories</label>
      <div class="checkbox-grid">
        <% categories.forEach(category => { %>
          <label class="checkbox-card" for="category-<%= category.category_id %>">
            <input
              type="checkbox"
              id="category-<%= category.category_id %>"
              name="categoryIds"
              value="<%= category.category_id %>"
              class="checkbox-input"
              <%= assignedCategories.some(ac => ac.category_id === category.category_id) ? 'checked' : '' %>
            />
            <span class="checkbox-label"><%= category.name %></span>
          </label>
        <% }); %>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary">Update Categories</button>
      <a href="/project/<%= projectId %>" class="btn-secondary">Cancel</a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
