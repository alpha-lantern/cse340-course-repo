<%- include('partials/header') %>
<main class="container">
    <h1 class="page-title"><%= title %></h1>
    <h2 class="hero-heading"><%= category.name %></h2>
    <!-- Projects List Section -->
    <section class="category-projects-section">
        <h3 class="section-subtitle">Featured Projects</h3>
        <% if (projects && projects.length > 0) { %>
            <ul class="project-list">
                <% projects.forEach(project => { %>
                    <li class="project-card">
                        <div class="project-content">
                            <% if (project.project_date) { %>
                                <p class="project-date">
                                    📅 <%= project.project_date.toLocaleDateString('es-ES', { 
                                        weekday: 'long', 
                                        year: 'numeric', 
                                        month: 'long', 
                                        day: 'numeric' 
                                    }) %>
                                </p>
                            <% } %>
                            <h4 class="project-title">
                                <a href="/project/<%= project.project_id %>" class="project-link">
                                    <%= project.title %>
                                </a>
                            </h4>
                        </div>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p class="no-projects-msg">No active projects found for this category.</p>
        <% } %>
    </section>
    <div class="category-actions">
        <a href="/categories" class="btn-primary">← Back to Categories</a>
    </div>
</main>
<%- include('partials/footer') %>