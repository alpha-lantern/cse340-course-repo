<%- include('partials/header') %>
<main class="container">
  <h1 class="page-title"><%= projectDetails.title %></h1>

  <form action="/edit-project/<%= projectId %>" method="POST" class="form-container">
    <div class="form-group">
      <label for="title" class="form-label">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        class="form-control"
        maxlength="200"
        required
        value="<%= projectDetails.title %>"
      />
    </div>

    <div class="form-group">
      <label for="description" class="form-label">Description</label>
      <textarea
        id="description"
        name="description"
        class="form-control"
        maxlength="1000"
        rows="5"
        placeholder="Details about tasks, requirements, and schedule..."
        required
      ><%= projectDetails.description %></textarea>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="location" class="form-label">Location</label>
        <input
          type="text"
          id="location"
          name="location"
          class="form-control"
          maxlength="255"
          placeholder="e.g., Central Park Pavilion"
          required
          value="<%= projectDetails.location %>"
        />
      </div>

      <div class="form-group">
        <label for="date" class="form-label">Date</label>
        <input
          type="date"
          id="date"
          name="date"
          class="form-control"
          value="<%= projectDetails.project_date ? 
            (d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`)
            (new Date(projectDetails.project_date)) : '' %>"
          required
        />
      </div>
    </div>

    <div class="form-group">
      <label for="organizationId" class="form-label">Organization</label>
      <select
        id="organizationId"
        name="organizationId"
        class="form-control"
        required
      >
        <option value="<%= hostOrganization.organization_id %>" selected><%= hostOrganization.name %></option>
        <% organizations.forEach(org => { %>
          <option value="<%= org.organization_id %>"><%= org.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="actions-group">
      <button type="submit" class="btn btn-primary">Update Project</button>
      <a href="/project/<%= projectId %>" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
