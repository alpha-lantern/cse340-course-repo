<%- include('partials/header') %>
<main class="container">
  <h1 class="page-title">Edit Category</h1>

  <form action="/edit-category/<%= category.category_id %>" method="POST" class="form-container">
    <div class="form-group">
      <label for="name" class="form-label">Name</label>
      <input
        type="text"
        id="name"
        name="name"
        class="form-control"
        maxlength="100"
        value="<%= category.name %>"
        required
      />
    </div>
    <div class="form-actions">
      <button type="submit" class="btn-primary">Edit Category</button>
      <a href="/category/<%= category.category_id %>" class="btn-secondary">Cancel</a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>